# AWS IAM Best Practices — Euclid IR
#
# Industry-standard patterns for IAM security.
# These rules express well-known AWS best practices as logical constraints.

# ── Pattern 1: Separation of Duties ──
# A user who can deploy should NOT also approve deployments.
# A user who can create roles should NOT assign them to themselves.

violates_separation_of_duties($user) IF
    user($user) AND has_permission($user, deploy_code) AND has_permission($user, approve_deploy)  # rule: AWS-IAM-SoD-1

violates_separation_of_duties($user) IF
    user($user) AND has_permission($user, create_role) AND has_permission($user, assign_role)  # rule: AWS-IAM-SoD-2

# ── Pattern 2: Least Privilege ──
# Users with more than 15 direct permissions should be reviewed.

excessive_permissions($user, $count) IF
    user($user) AND permission_count($user, $count) AND $count > 15  # rule: AWS-IAM-LeastPrivilege-1

# ── Pattern 3: Stale Access ──
# Users who haven't logged in for 90+ days retain permissions.

stale_access($user) IF
    user($user) AND is_active($user) AND last_login_days($user, $days) AND $days > 90  # rule: AWS-IAM-StaleAccess-1

# ── Pattern 4: Unused Permissions ──
# Permissions granted but never used in the last 30 days.
# NOTE: requires a last_used_days/2 data source not present in the example
# dataset, so this pattern is not enabled in the example KB.

# ── Pattern 5: Cross-Account Access ──
# Cross-account roles should require MFA.
# NOTE: requires a cross_account_role/1 data source not present in the
# example dataset, so this pattern is not enabled in the example KB.

# ── Pattern 6: Privilege Escalation Paths ──
# Users who can modify IAM policies can escalate their own privileges.

privilege_escalation_risk($user) IF
    user($user) AND has_permission($user, attach_user_policy) AND has_permission($user, create_access_key)  # rule: AWS-IAM-PrivEscalation-1

privilege_escalation_risk($user) IF
    user($user) AND has_permission($user, put_role_policy) AND has_permission($user, assume_role)  # rule: AWS-IAM-PrivEscalation-2

# ── Pattern 7: Root Account Protection ──
# Root account should have no access keys, no MFA bypass.
# NOTE: requires iam_user/1 root-account facts not present in the example
# dataset, so this pattern is not enabled in the example KB.

# ── Pattern 8: Service Account Hygiene ──
# Service accounts should not have interactive console access.

service_account_risk($user) IF
    user($user) AND account_type($user, service) AND has_console_access($user)  # rule: AWS-IAM-ServiceAccount-1

# ── Pattern 9: Administrative Boundary ──
# No single user should have both user management AND billing access.

admin_boundary_violation($user) IF
    user($user) AND has_permission($user, manage_users) AND has_permission($user, manage_billing)  # rule: AWS-IAM-AdminBoundary-1

admin_boundary_violation($user) IF
    user($user) AND has_permission($user, manage_users) AND has_permission($user, create_invoice)  # rule: AWS-IAM-AdminBoundary-2

# ── Pattern 10: Resource-Level Permissions ──
# Permissions should be scoped to specific resources, not wildcards.
# NOTE: requires a has_wildcard_permission/2 data source not present in the
# example dataset, so this pattern is not enabled in the example KB.
