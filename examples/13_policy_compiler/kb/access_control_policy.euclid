# Compiled KB: POL-SEC-042 — Access Control Policy (rev. 4.2)
# Source: examples/13_policy_compiler/source/access_control_policy.md
# Compiled via document → Euclid-IR → check_kb pipeline (stage 4: curation).
# Each rule carries: # RULE: <id> and # src: <source document section>.
# NB: the engine captures the rule_id from the trailing comment: # src must therefore
# come before # RULE.

# --- Domain facts (Sections 2-3) ---
# Section 2. Environments and minimum levels
environment(production, tier_1)
environment(golden, tier_1)
environment(staging, tier_2)
environment(development, tier_3)

deploy_requires_level(production, 6)
deploy_requires_level(golden, 6)
deploy_requires_level(staging, 4)
deploy_requires_level(development, 2)

# Section 3. Roles and hierarchy
role(intern)
role(junior_dev)
role(mid_senior_dev)
role(senior_dev)
role(tech_lead)
role(eng_manager)
role(director)
role(vp_engineering)
role(cto)

deploy_role_level(intern, 0)
deploy_role_level(junior_dev, 1)
deploy_role_level(mid_senior_dev, 2)
deploy_role_level(senior_dev, 3)
deploy_role_level(tech_lead, 4)
deploy_role_level(eng_manager, 5)
deploy_role_level(director, 6)
deploy_role_level(vp_engineering, 7)
deploy_role_level(cto, 8)

# --- Domain facts (Section 5) ---
classification(public, 1)
classification(internal, 2)
classification(confidential, 3)
classification(secret, 4)

# --- Rules (Section 1) ---
can_access_system($u) IF user($u) AND is_active($u)  # src: 1_oggetto_e_ambito_di_applicazione  # RULE: SEC-1-1
no_access($u) IF user($u) AND NOT is_active($u)  # src: 1_oggetto_e_ambito_di_applicazione  # RULE: SEC-1-2

# --- Rule (Section 4) ---
can_deploy($u, $env) IF
    user($u) AND
    is_active($u) AND
    has_permission($u, deploy_code) AND
    has_role($u, $role) AND
    deploy_role_level($role, $lvl) AND
    deploy_requires_level($env, $min) AND
    $lvl >= $min  # src: 4_facolta_di_rilascio  # RULE: SEC-4-1

# --- Rule (Section 5) ---
can_access_data($u, $data) IF
    user($u) AND
    is_active($u) AND
    user_clearance($u, $level) AND
    dataset($data, $min) AND
    $level >= $min  # src: 5_accesso_ai_dati_classificati  # RULE: SEC-5-1

# --- Rule (Section 6) ---
# Design note: the engine does not compare atoms (== is arithmetic, not
# unification), so self-approval is detected at event ingress
# and materialized as the self_approved/1 fact (denormalized pattern,
# standard in access control systems).
emergency_access($u) IF
    incident_mode(active) AND
    user($u) AND
    is_active($u) AND
    approved_by($u, $approver) AND
    NOT self_approved($u)  # src: 6_accesso_in_emergenza  # RULE: SEC-6-1

# --- Rule (Section 7) ---
deroga_access_data($u, $data) IF
    user($u) AND
    is_active($u) AND
    written_authorization($u, $data) AND
    NOT suspended($u)  # src: 7_deroghe  # RULE: SEC-7-1

# --- Registry and operational data (not from document: system data) ---
user(alice)
user(bob)
user(carol)
user(dave)
user(eve)

is_active(alice)
is_active(bob)
is_active(carol)
is_active(dave)

has_role(alice, director)
has_role(bob, eng_manager)
has_role(carol, tech_lead)
has_role(dave, sysadmin)
has_role(eve, senior_dev)

has_permission(alice, deploy_code)
has_permission(bob, deploy_code)
has_permission(carol, deploy_code)
has_permission(eve, deploy_code)

user_clearance(alice, 4)
user_clearance(bob, 3)
user_clearance(carol, 2)
user_clearance(dave, 4)
user_clearance(eve, 2)

dataset(customer_db, 3)
dataset(pii_db, 4)
dataset(public_docs, 1)

incident_mode(active)

approved_by(bob, alice)
approved_by(carol, carol)

self_approved(carol)

written_authorization(alice, pii_db)

suspended(eve)
