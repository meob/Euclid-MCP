# KB compilata: Regolamento (UE) 2024/1689 — articolo 6, paragrafo 3
# Sorgente: examples/13_policy_compiler/source/ai_act_art6_3.md
# Compilata con il flusso documento -> Euclid-IR -> check_kb (stadio 4: curatela).
# Ogni regola porta: # RULE: <id> e # src: <sezione del documento sorgente>.
# NB: il motore cattura il rule_id dal commento a fine regola: # src va quindi
# prima di # RULE.

# --- Fatti: sistemi di IA in valutazione (anagrafica, non dal documento) ---
ai_system(hr_screening_01)
ai_system(resume_rank_02)
ai_system(spam_filter_03)
ai_system(loan_score_04)
ai_system(auto_review_05)

# Rientra nell'allegato III dell'AI Act?
listed_annex3(hr_screening_01)
listed_annex3(resume_rank_02)
listed_annex3(loan_score_04)
listed_annex3(auto_review_05)

# Rischio significativo di danno? Se presente, la deroga non si applica.
no_significant_risk(hr_screening_01)
no_significant_risk(resume_rank_02)
no_significant_risk(loan_score_04)
no_significant_risk(auto_review_05)

# Condizioni della deroga (lettere a-d)
limited_procedural_task(hr_screening_01)
improves_prior_result(loan_score_04)
detects_pattern_deviation(auto_review_05)
replaces_human_review(auto_review_05)
preparatory_task(resume_rank_02)

# Profilazione di persone fisiche (art. 3, par. 1, punto 4)
performs_profiling(hr_screening_01)
performs_profiling(loan_score_04)

# --- Regole (primo comma) ---
deroga_applicabile($s) IF
    ai_system($s) AND
    listed_annex3($s) AND
    no_significant_risk($s) AND
    condizione_deroga($s) AND
    NOT performs_profiling($s)  # src: articolo_6_paragrafo_3_primo_comma  # RULE: AIACT-6-3-1

# --- Regole (lettere a-d) ---
condizione_deroga($s) IF ai_system($s) AND limited_procedural_task($s)  # src: articolo_6_paragrafo_3_lettera_a  # RULE: AIACT-6-3-2
condizione_deroga($s) IF ai_system($s) AND improves_prior_result($s)  # src: articolo_6_paragrafo_3_lettera_b  # RULE: AIACT-6-3-3
condizione_deroga($s) IF
    ai_system($s) AND
    detects_pattern_deviation($s) AND
    NOT replaces_human_review($s)  # src: articolo_6_paragrafo_3_lettera_c  # RULE: AIACT-6-3-4
condizione_deroga($s) IF ai_system($s) AND preparatory_task($s)  # src: articolo_6_paragrafo_3_lettera_d  # RULE: AIACT-6-3-5

# --- Regole (classificazione) ---
high_risk($s) IF
    ai_system($s) AND
    listed_annex3($s) AND
    NOT deroga_applicabile($s)  # src: articolo_6_paragrafo_3_primo_comma  # RULE: AIACT-6-3-6
always_high_risk($s) IF
    ai_system($s) AND
    listed_annex3($s) AND
    performs_profiling($s)  # src: articolo_6_paragrafo_3_ultimo_comma  # RULE: AIACT-6-3-7
high_risk($s) IF always_high_risk($s)  # src: articolo_6_paragrafo_3_ultimo_comma  # RULE: AIACT-6-3-8
