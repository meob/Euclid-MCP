{
  "name": "Euclid-IR",
  "scopeName": "source.euclid",
  "filePatterns": ["*.euclid"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#version-directive" },
    { "include": "#query" },
    { "include": "#rule" },
    { "include": "#fact" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.euclid",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.euclid",
          "match": "//.*$"
        },
        {
          "name": "comment.line.percent.euclid",
          "match": "%.*$"
        }
      ]
    },
    "version-directive": {
      "patterns": [
        {
          "name": "keyword.control.version.euclid",
          "match": "^\\s*@version\\s+\\d+\\.\\d+"
        }
      ]
    },
    "query": {
      "patterns": [
        {
          "name": "keyword.control.query.euclid",
          "match": "^\\s*\\?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.operator.logical.euclid",
          "match": "\\b(IF|AND|NOT)\\b"
        },
        {
          "name": "keyword.operator.is.euclid",
          "match": "\\bis\\b"
        }
      ]
    },
    "rule": {
      "patterns": [
        {
          "match": "^\\s*([a-z_]\\w*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.rule-head.euclid" }
          },
          "push": "rule-body"
        }
      ]
    },
    "rule-body": [
      { "include": "#comments" },
      { "include": "#strings" },
      { "include": "#keywords" },
      { "include": "#variables" },
      { "include": "#arithmetic-operators" },
      { "include": "#comparison-operators" },
      { "include": "#punctuation" },
      { "include": "#predicate-call" },
      { "include": "#wildcard" },
      { "include": "#rule-id-comment" },
      { "match": "(?<=\\n)|^(?=\\s*\\S)", "pop": 1 }
    ],
    "fact": {
      "patterns": [
        {
          "match": "^\\s*([a-z_]\\w*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.fact.euclid" }
          },
          "push": "fact-body"
        },
        {
          "match": "^\\s*([a-z_]\\w*)\\s*(?=\\n|$|#|//|%)",
          "captures": {
            "1": { "name": "entity.name.function.fact-zero-arity.euclid" }
          }
        }
      ]
    },
    "fact-body": [
      { "include": "#comments" },
      { "include": "#strings" },
      { "include": "#variables" },
      { "include": "#wildcard" },
      { "include": "#punctuation" },
      { "include": "#predicate-call" },
      { "match": "(?<=\\n)|^(?=\\s*\\S)", "pop": 1 }
    ],
    "predicate-call": {
      "patterns": [
        {
          "match": "\\b([a-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.predicate-call.euclid" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.euclid",
          "match": "\\$[a-z_]\\w*"
        }
      ]
    },
    "wildcard": {
      "patterns": [
        {
          "name": "variable.language.wildcard.euclid",
          "match": "(?<=\\s|\\(|,|^)_\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.euclid",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.euclid" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.euclid" } },
          "patterns": [
            {
              "name": "constant.character.escape.euclid",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.euclid",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.euclid" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.euclid" } },
          "patterns": [
            {
              "name": "constant.character.escape.euclid",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "arithmetic-operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.euclid",
          "match": "[+\\-*/]"
        }
      ]
    },
    "comparison-operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.euclid",
          "match": ">=|<=|==|!=|>|<"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.arguments.begin.euclid",
          "match": "\\("
        },
        {
          "name": "punctuation.section.arguments.end.euclid",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.comma.euclid",
          "match": ","
        }
      ]
    },
    "rule-id-comment": {
      "patterns": [
        {
          "name": "comment.rule-id.euclid",
          "match": "#\\s*[Rr]ule:\\s*\\S+.*$"
        }
      ]
    }
  }
}
